# Server-side environment template for the DDD Python platform.
# NEVER copy these values into the Android project or APK.

APP_ENV=production
JWT_SECRET=replace-with-a-long-random-secret
AGENT_INTERNAL_TOKEN=replace-with-a-different-long-random-secret
GEMINI_API_KEY=replace-with-server-side-gemini-key
RATE_LIMIT_MAX_REQUESTS=100

REPO_SERVICE_GRPC=repo-service:50051
AGENT_SERVICE_GRPC=agent-service:50052
DEPLOYMENT_SERVICE_GRPC=deployment-service:50053
INCIDENT_SERVICE_GRPC=incident-service:50055
