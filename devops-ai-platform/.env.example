# Server-side environment template for the DDD Python platform.
# NEVER copy these values into the Android project or APK.
#
# The GEMINI_* surface below is the COMPLETE validated configuration
# (GeminiRuntimeConfig, agent-service/infrastructure/llm/gemini_caller.py).
# Phase 8.7-D.1-CORRECTION-3 (Finding B): every float field must be FINITE
# (NaN/±inf are rejected at construction — fail closed, before any provider
# contact); the documented range semantics are in the comments. This is an
# APPLICATION safety budget, not a Google billing cap.

APP_ENV=production
JWT_SECRET=replace-with-a-long-random-secret
AGENT_INTERNAL_TOKEN=replace-with-a-different-long-random-secret

# ---------------------------------------------------------------------------
# Server-side Gemini (agent-service) — complete validated surface
# ---------------------------------------------------------------------------

# Provider credential. Server-side ONLY; never in the Android app. Absent
# => every generation call fails closed (no fabricated responses).
GEMINI_API_KEY=replace-with-server-side-gemini-key

# Model (default: gemini-3.8-flash — the currently supported stable 3.x).
GEMINI_MODEL=gemini-3.8-flash

# Application safety budget ceiling (USD) per UTC calendar month.
# Must be FINITE and >= 0. A ZERO budget is legal and means "no calls this
# period" (every reservation is rejected immediately) — never "unlimited".
GEMINI_MONTHLY_BUDGET_USD=150.0

# Pricing per 1M tokens (USD). Both must be FINITE and > 0 — a zero rate
# would silently disable cost accounting while calls still happen.
GEMINI_INPUT_COST_PER_MILLION_USD=1.50
GEMINI_OUTPUT_COST_PER_MILLION_USD=7.50

# Provider-side output ceiling (tokens), and the bounded maximum output
# allowance used for budget reservations. int >= 1.
GEMINI_MAX_OUTPUT_TOKENS=16384

# Compatibility FLOOR ONLY (Phase 8.7-D.1-CORRECTION-3, Finding C): the
# per-request input allowance is the documented UTF-8 byte bound of the
# validated input (+ framing), and the effective allowance is
# max(byte bound, this value) — setting this SMALL cannot lower the
# per-request safe bound. int >= 1.
GEMINI_ESTIMATED_PROMPT_TOKENS=220

# Provider request timeout (seconds). Must be FINITE and > 0.
GEMINI_TIMEOUT_SECONDS=20.0

# Bounded retry budget for CLOSED-circuit calls (int >= 1). A half-open
# probe ALWAYS gets exactly ONE provider attempt regardless of this.
GEMINI_MAX_RETRIES=3

# Initial retry backoff (seconds); doubles per retry. Must be FINITE and
# >= 0 (0 = no wait, used deliberately by some tests).
GEMINI_BACKOFF_BASE_SECONDS=0.5

# Budget store: "local" = in-process ledger (SINGLE-PROCESS contract; the
# ceiling multiplies by replica count — use only for one agent instance),
# "redis" = shared ledger across replicas (requires REDIS_URL).
# In non-development APP_ENV (staging/production/empty/missing/unexpected)
# the shared store is REQUIRED unless GEMINI_BUDGET_SINGLE_INSTANCE_PRODUCTION
# is set explicitly (documented opt-out).
GEMINI_BUDGET_STORE=redis

# Shared store URL (required for GEMINI_BUDGET_STORE=redis; also used by
# the shared analysis rate limiter in non-development environments).
REDIS_URL=redis://redis:6379/0

# Explicit single-replica opt-out for the budget store in non-development
# APP_ENV. Only set this when you actually run exactly one agent replica.
# GEMINI_BUDGET_SINGLE_INSTANCE_PRODUCTION=true

# ---------------------------------------------------------------------------
# Gateway
# ---------------------------------------------------------------------------

# Analysis rate limiting (per-subject / per-IP, per minute) — see
# api-gateway/core/analysis_rate_limit.py for the complete validated set.
RATE_LIMIT_MAX_REQUESTS=100

# ---------------------------------------------------------------------------
# gRPC service endpoints (service-to-service)
# ---------------------------------------------------------------------------

REPO_SERVICE_GRPC=repo-service:50051
AGENT_SERVICE_GRPC=agent-service:50052
DEPLOYMENT_SERVICE_GRPC=deployment-service:50053
INCIDENT_SERVICE_GRPC=incident-service:50055
