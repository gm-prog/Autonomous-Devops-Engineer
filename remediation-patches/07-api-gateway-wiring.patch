+"""API Gateway entrypoint (BFF layer in front of the platform microservices).
+
+Run from this directory:
+
+    uvicorn main:app --host 0.0.0.0 --port 8000
+
+Auth: every /v1/gateway/* route requires `Authorization: Bearer <JWT>`.
+Mint a dev token with:
+
+    python -m core.auth <subject> [Role1 Role2 ...]
+"""
+from fastapi import FastAPI
+
+from routers.gateway_router import router as gateway_router
+
+app = FastAPI(title="DevOps Platform API Gateway", version="1.0.0")
+
+app.include_router(gateway_router)
+
+
+@app.get("/health")
+def health():
+    return {"status": "healthy", "service": "api-gateway"}
