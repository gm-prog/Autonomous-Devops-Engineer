+"""Smoke tests for gateway health, JWT enforcement and dispatch routing.
+
+Run from devops-ai-platform/api-gateway:
+
+    PYTHONPATH=. python -m unittest tests.test_gateway -v
+
+Requires httpx (installed in CI alongside requirements.txt) for TestClient.
+"""
+import unittest
+
+from fastapi.testclient import TestClient
+
+import main
+from core.auth import mint_token
+
+client = TestClient(main.app)
+
+
+def authed(token: str) -> dict:
+    return {"Authorization": f"Bearer {token}"}
+
+
+class GatewayHealthTest(unittest.TestCase):
+    def test_health_is_public(self):
+        resp = client.get("/health")
+        self.assertEqual(resp.status_code, 200)
+        self.assertEqual(resp.json()["service"], "api-gateway")
+
+
+class GatewayAuthTest(unittest.TestCase):
+    def test_missing_token_rejected(self):
+        resp = client.get("/v1/gateway/metrics")
+        self.assertIn(resp.status_code, (401, 403))
+
+    def test_valid_token_accepted(self):
+        token = mint_token("gateway-operator", ["DevOpsLead"])
+        resp = client.get("/v1/gateway/metrics", headers=authed(token))
+        self.assertEqual(resp.status_code, 200)
+        self.assertEqual(resp.json()["gateway_status"], "ONLINE")
+
+    def test_tampered_token_rejected(self):
+        token = mint_token("gateway-operator", ["DevOpsLead"])
+        head, body, sig = token.split(".")
+        flipped = ("AA" if not sig.endswith("AA") else "BB")
+        tampered = f"{head}.{body}.{sig[:-2]}{flipped}"
+        resp = client.get("/v1/gateway/metrics", headers=authed(tampered))
+        self.assertEqual(resp.status_code, 401)
+
+    def test_expired_token_rejected(self):
+        token = mint_token("gateway-operator", ["DevOpsLead"], ttl_seconds=-10)
+        resp = client.get("/v1/gateway/metrics", headers=authed(token))
+        self.assertEqual(resp.status_code, 401)
+
+    def test_legacy_mock_backdoor_token_rejected(self):
+        # The pre-patch backdoor accepted this literal as an admin identity.
+        resp = client.get(
+            "/v1/gateway/metrics",
+            headers=authed("mock-devops-admin-token-1842"),
+        )
+        self.assertEqual(resp.status_code, 401)
+
+    def test_short_garbage_token_rejected(self):
+        resp = client.get("/v1/gateway/metrics", headers=authed("abc"))
+        self.assertEqual(resp.status_code, 401)
+
+
+class GatewayDispatchTest(unittest.TestCase):
+    def test_unknown_service_404(self):
+        token = mint_token("gateway-operator")
+        resp = client.post(
+            "/v1/gateway/dispatch/nonexistent",
+            json={"a": 1},
+            headers=authed(token),
+        )
+        self.assertEqual(resp.status_code, 404)
+
+    def test_known_service_passthrough_echoes_identity(self):
+        token = mint_token("gateway-operator", ["DevOpsLead"])
+        resp = client.post(
+            "/v1/gateway/dispatch/agent",
+            json={"task": "rca"},
+            headers=authed(token),
+        )
+        self.assertEqual(resp.status_code, 200)
+        data = resp.json()
+        self.assertEqual(data["status"], "PROXY_PASSTHROUGH")
+        self.assertEqual(data["authorizing_identity"], "gateway-operator")
+        self.assertEqual(data["payload_relayed"], {"task": "rca"})
+
+
+if __name__ == "__main__":
+    unittest.main()
